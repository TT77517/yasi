.mock-page {
  padding-top: 30rpx;
  padding-bottom: 72rpx;
  background: linear-gradient(160deg, #fff8fb 0%, #fffdf8 54%, #f3faf4 100%);
}

.mock-card {
  max-width: 620rpx;
  margin: 54rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mock-emoji {
  font-size: 54rpx;
  line-height: 1;
}

.mock-title {
  margin-top: 20rpx;
  color: #6e6a64;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.4;
}

.mock-description {
  margin-top: 14rpx;
  color: #9a958e;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.65;
}

.back-button {
  max-width: 620rpx;
  margin: 34rpx auto 0;
}
