.page {
  min-height: 100vh;
  padding: 192rpx 56rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  color: #172033;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.subtitle {
  margin-top: 24rpx;
  color: #7a8499;
  font-size: 28rpx;
  line-height: 1.5;
}

.actions {
  width: 100%;
  max-width: 620rpx;
  margin-top: 144rpx;
}

.action-button {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.action-button::after {
  border: 0;
}

.action-button--primary {
  color: #ffffff;
  background: #3157d5;
}

.action-button--secondary {
  margin-top: 28rpx;
  color: #3157d5;
  background: #edf1ff;
}

.action-button--cloud {
  margin-top: 28rpx;
  color: #59647a;
  background: #ffffff;
}

.cloud-result {
  margin-top: 24rpx;
  display: block;
  color: #59647a;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}
