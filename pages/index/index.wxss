.home-page {
  position: relative;
  overflow: hidden;
  padding-top: 34rpx;
  padding-bottom: 56rpx;
  background: linear-gradient(160deg, #fff8fb 0%, #fffdf8 48%, #f4fbf4 100%);
}

.ambient-shape {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  opacity: 0.5;
  pointer-events: none;
}

.ambient-shape--pink {
  top: -96rpx;
  right: -108rpx;
  width: 300rpx;
  height: 300rpx;
  background: #f8c8dc;
}

.ambient-shape--green {
  top: 510rpx;
  left: -150rpx;
  width: 270rpx;
  height: 270rpx;
  background: #cdeccf;
}

.brand-section,
.primary-actions,
.growth-card,
.garden-entry {
  position: relative;
  z-index: 1;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  position: relative;
  width: 104rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff5cc;
  border: 3rpx solid rgba(255, 120, 152, 0.18);
  border-radius: 48rpx 48rpx 48rpx 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(110, 106, 100, 0.07);
}

.brand-mark-tail {
  position: absolute;
  bottom: -9rpx;
  left: 16rpx;
  width: 24rpx;
  height: 24rpx;
  background: #fff5cc;
  transform: rotate(28deg);
  border-radius: 4rpx;
}

.flower {
  position: relative;
  z-index: 1;
  width: 56rpx;
  height: 56rpx;
}

.petal,
.flower-center {
  position: absolute;
  border-radius: 50%;
}

.petal {
  width: 26rpx;
  height: 26rpx;
  background: #ff7898;
}

.petal--top {
  top: 0;
  left: 15rpx;
}

.petal--right {
  top: 15rpx;
  right: 0;
}

.petal--bottom {
  bottom: 0;
  left: 15rpx;
}

.petal--left {
  top: 15rpx;
  left: 0;
}

.flower-center {
  top: 18rpx;
  left: 18rpx;
  width: 20rpx;
  height: 20rpx;
  background: #fffdf8;
  box-shadow: inset 0 0 0 3rpx rgba(255, 245, 204, 0.9);
}

.brand-name {
  margin-top: 22rpx;
  color: #6e6a64;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.brand-slogan {
  margin-top: 10rpx;
  color: #9a958e;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.brand-welcome {
  margin-top: 16rpx;
  color: #6e6a64;
  font-size: 28rpx;
  line-height: 1.5;
}

.primary-actions {
  margin-top: 40rpx;
}

.practice-button,
.mock-button {
  font-size: 31rpx;
}

.practice-button {
  box-shadow: 0 12rpx 26rpx rgba(255, 120, 152, 0.18);
}

.action-note {
  margin-top: 14rpx;
  display: block;
  color: #9a958e;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}

.mock-button {
  margin-top: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(105, 156, 114, 0.12);
}

.growth-card {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.growth-caption {
  color: #9a958e;
  font-size: 22rpx;
}

.growth-stats {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
}

.growth-stat {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
}

.growth-value {
  color: #ff7898;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.growth-value--green {
  color: #76bd82;
}

.growth-unit {
  margin-left: 6rpx;
  color: #6e6a64;
  font-size: 22rpx;
}

.growth-label {
  width: 100%;
  margin-top: 8rpx;
  color: #9a958e;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.growth-divider {
  width: 2rpx;
  height: 62rpx;
  background: rgba(110, 106, 100, 0.1);
}

.garden-entry {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 245, 204, 0.56);
  border: 2rpx solid rgba(168, 230, 178, 0.36);
  border-radius: 24rpx;
  transition: transform 220ms ease, opacity 220ms ease;
}

.sprout-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.76);
  border-radius: 50%;
}

.sprout-stem {
  position: absolute;
  bottom: 12rpx;
  left: 30rpx;
  width: 4rpx;
  height: 30rpx;
  background: #76bd82;
  border-radius: 4rpx;
}

.sprout-leaf {
  position: absolute;
  top: 18rpx;
  width: 22rpx;
  height: 14rpx;
  background: #a8e6b2;
}

.sprout-leaf--left {
  left: 10rpx;
  border-radius: 16rpx 4rpx 16rpx 4rpx;
  transform: rotate(18deg);
}

.sprout-leaf--right {
  right: 9rpx;
  border-radius: 4rpx 16rpx 4rpx 16rpx;
  transform: rotate(-18deg);
}

.garden-copy {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.garden-title {
  color: #6e6a64;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
}

.garden-subtitle {
  margin-top: 5rpx;
  color: #9a958e;
  font-size: 22rpx;
  line-height: 1.4;
}

.garden-arrow {
  margin-left: 16rpx;
  color: #76bd82;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
}
