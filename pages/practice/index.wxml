<view class="page">
  <text class="page-label">AI轻陪练</text>

  <view wx:if="{{status === 'idle'}}" class="panel">
    <text class="eyebrow">AI QUESTION</text>
    <text class="question">What do you usually do at weekends?</text>
    <button class="primary-button" bindtap="startRecord">开始回答</button>
  </view>

  <view wx:elif="{{status === 'recording'}}" class="panel">
    <view class="recording-indicator">
      <view class="recording-dot"></view>
      <text class="status-title">正在听你说……</text>
    </view>
    <button class="primary-button" bindtap="stopRecord">结束回答</button>
  </view>

  <view wx:elif="{{status === 'analyzing'}}" class="panel">
    <text class="status-title">正在分析你的回答……</text>
    <view class="steps">
      <view class="step">
        <view class="step-dot"></view>
        <text>正在识别语音</text>
      </view>
      <view class="step">
        <view class="step-dot"></view>
        <text>正在评测表达</text>
      </view>
      <view class="step">
        <view class="step-dot"></view>
        <text>正在生成建议</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{status === 'feedback' && feedback}}" class="panel">
    <text class="feedback-title">今天做得很好</text>
    <view class="feedback-card">
      <text class="feedback-label">我听到你说</text>
      <text class="feedback-text transcript-text">{{transcript}}</text>
    </view>
    <view class="feedback-card">
      <text class="feedback-label">整体反馈</text>
      <text class="feedback-text">{{feedback.overallFeedback}}</text>
    </view>
    <view class="feedback-card">
      <text class="feedback-label">语法建议</text>
      <block wx:if="{{feedback.grammarCorrections.length}}">
        <view
          wx:for="{{feedback.grammarCorrections}}"
          wx:key="original"
          class="feedback-item"
        >
          <text class="feedback-detail"><text class="detail-label">原表达：</text>{{item.original}}</text>
          <text class="feedback-detail"><text class="detail-label">修改后：</text>{{item.corrected}}</text>
          <text class="feedback-detail explanation-text">{{item.explanation}}</text>
        </view>
      </block>
      <text wx:else class="feedback-text empty-text">这次没有明显语法问题</text>
    </view>
    <view class="feedback-card">
      <text class="feedback-label">词汇升级</text>
      <block wx:if="{{feedback.vocabularySuggestions.length}}">
        <view
          wx:for="{{feedback.vocabularySuggestions}}"
          wx:key="original"
          class="feedback-item"
        >
          <text class="feedback-detail"><text class="detail-label">原表达：</text>{{item.original}}</text>
          <text class="feedback-detail"><text class="detail-label">建议：</text>{{item.suggestion}}</text>
          <text class="feedback-detail example-text">{{item.example}}</text>
        </view>
      </block>
      <text wx:else class="feedback-text empty-text">这次表达已经很自然</text>
    </view>
    <view class="feedback-card">
      <text class="feedback-label">优化后的回答</text>
      <text class="feedback-text transcript-text">{{feedback.improvedAnswer}}</text>
    </view>
    <view class="feedback-card next-tip-card">
      <text class="feedback-label">下一次只改这一点</text>
      <text class="feedback-text next-tip-text">{{feedback.nextTip}}</text>
    </view>
    <view class="feedback-actions">
      <button class="primary-button" bindtap="retryAnswer">再说一次</button>
      <button class="secondary-button" bindtap="completePractice">完成练习</button>
    </view>
  </view>
</view>
