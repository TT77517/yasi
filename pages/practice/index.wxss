.page {
  min-height: 100vh;
  padding: 80rpx 56rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-label {
  color: #7a8499;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.panel {
  width: 100%;
  max-width: 620rpx;
  margin-top: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.eyebrow {
  color: #3157d5;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.question {
  margin-top: 28rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
}

.recording-indicator {
  display: flex;
  align-items: center;
}

.recording-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 16rpx;
  background: #e45858;
  border-radius: 50%;
}

.status-title,
.feedback-title {
  color: #172033;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.steps {
  width: 100%;
  margin-top: 56rpx;
  padding: 36rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.step {
  display: flex;
  align-items: center;
  color: #59647a;
  font-size: 28rpx;
  line-height: 1.5;
}

.step + .step {
  margin-top: 28rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 20rpx;
  background: #9bace8;
  border-radius: 50%;
}

.feedback-title {
  margin-bottom: 24rpx;
}

.feedback-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 24rpx;
}

.feedback-label {
  color: #3157d5;
  font-size: 24rpx;
  font-weight: 600;
}

.feedback-text {
  margin-top: 14rpx;
  color: #59647a;
  font-size: 28rpx;
  line-height: 1.6;
}

.feedback-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  border-top: 2rpx solid #edf0f6;
}

.feedback-detail {
  color: #59647a;
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-word;
}

.feedback-detail + .feedback-detail {
  margin-top: 8rpx;
}

.detail-label {
  color: #303b52;
  font-weight: 600;
}

.explanation-text,
.example-text,
.empty-text {
  color: #7a8499;
}

.next-tip-card {
  background: #edf1ff;
}

.next-tip-text {
  color: #303b52;
  font-weight: 600;
}

.feedback-actions {
  width: 100%;
  margin-top: 56rpx;
}

.feedback-actions .primary-button {
  margin-top: 0;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.primary-button {
  margin-top: 112rpx;
  color: #ffffff;
  background: #3157d5;
}

.secondary-button {
  margin-top: 24rpx;
  color: #3157d5;
  background: #edf1ff;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}
